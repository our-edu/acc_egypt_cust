 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>\u0623\u0645\u0631 \u0634\u0631\u0627\u0621</title>\n\n    <style>\n    .header-box {\n        flex: 1;\n    }\n\n    body {\n        font-family: Arial, sans-serif;\n        margin: 40px;\n        direction: rtl;\n        text-align: right;\n    }\n\n    .container {\n        max-width: 900px;\n        margin: auto;\n    }\n\n    .header, .section {\n        margin-bottom: 20px;\n    }\n\n    .flex {\n        display: flex;\n        justify-content: space-between;\n        flex-direction: row-reverse;\n    }\n\n    .left {\n        text-align: left;\n        direction: ltr;\n    }\n\n    h1 {\n        margin-bottom: 5px;\n    }\n\n    table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-top: 20px;\n    }\n\n    table, th, td {\n        border: 1px solid #ddd;\n    }\n\n    th, td {\n        padding: 10px;\n        text-align: right;\n    }\n\n    .totals {\n        width: 300px;\n        margin-right: auto;\n        margin-top: 20px;\n    }\n\n    \n\n    .notes {\n    width: 100%;\n    text-align: right;\n}\n\n    .company-logo {\n        height: 133px;\n        width: 133px;\n        margin-bottom: 10px;\n    }\n    </style>\n</head>\n\n<body>\n<div class=\"container\">\n\n    <!-- Header -->\n<div class=\"header flex\" style=\"align-items: flex-start;\">\n\n    <!-- RIGHT: Purchase Order Info -->\n    <div class=\"header-box\">\n        <h1 style=\"margin: 0;\">\u0623\u0645\u0631 \u0634\u0631\u0627\u0621</h1>\n        <p style=\"margin: 5px 0;\">{{ doc.name }}</p>\n        <p><strong>\u0627\u0644\u062a\u0627\u0631\u064a\u062e:</strong> {{ doc.transaction_date }}</p>\n    </div>\n\n    <!-- LEFT: Company Info -->\n    <div class=\"header-box\">\n        {% set company_logo = frappe.db.get_value('Company', doc.company, 'company_logo') %}\n        {% if company_logo %}\n            <p><img src=\"{{ company_logo }}\" class=\"company-logo\"></p>\n        {% endif %}\n\n        <p><strong>{{ doc.company }}</strong></p>\n\n        {% set company_address = frappe.db.get_value('Dynamic Link', {\n            'link_doctype': 'Company',\n            'link_name': doc.company,\n            'parenttype': 'Address'\n        }, 'parent') %}\n\n        {% set zatca = frappe.get_doc('ZATCA Business Settings', {'company': doc.company}) %}\n\n        {% if company_address %}\n            {% set addr = frappe.get_doc('Address', company_address) %}\n\n            <p>\n                {{ addr.custom_building_number or '' }}\n                {% if addr.custom_building_number %}, {% endif %}\n\n                {{ addr.address_line1 or '' }}<br>\n\n                {{ addr.city or '' }}\n                {% if addr.country %}, {{ addr.country }}{% endif %}<br>\n\n                {% if zatca.vat_registration_number %}\n                    \u0631\u0642\u0645 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0636\u0631\u064a\u0628\u064a: {{ zatca.vat_registration_number }}<br>\n                {% endif %}\n\n                {% for row in zatca.other_ids %}\n                    {% if row.type_code == \"CRN\" %}\n                        \u0631\u0642\u0645 \u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a: {{ row.value }}<br>\n                        \u0635\u0646\u062f\u0648\u0642 \u0627\u0644\u0628\u0631\u064a\u062f: {{ addr.pincode or '' }}\n                    {% endif %}\n                {% endfor %}\n            </p>\n        {% endif %}\n    </div>\n\n</div>\n\n    <!-- Supplier / Shipping Address -->\n    <div class=\"section flex\">\n        <div>\n            <strong>\u0627\u0644\u0634\u062d\u0646 \u0625\u0644\u0649:</strong><br>\n\n            {% if doc.shipping_address %}\n                {% set addr = frappe.get_doc(\"Address\", doc.shipping_address) %}\n\n                {# Line 1: pincode + street #}\n                {{ addr.pincode or '' }} {{ addr.address_line1 or '' }}<br>\n\n                {# Line 2: city + state + country #}\n                {{ addr.city or '' }} {{ addr.state or '' }} {{ addr.country or '' }}\n            {% endif %}\n        </div>\n\n        <div>\n            <strong>\u0627\u0644\u0645\u0648\u0631\u062f:</strong><br>\n            {{ doc.supplier_name }}<br>\n            {% set supplier_tax = frappe.db.get_value(\"Supplier\", doc.supplier, \"tax_id\") %}\n            {% if supplier_tax %}\n                \u0631\u0642\u0645 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0636\u0631\u064a\u0628\u064a: {{ supplier_tax }}\n            {% endif %}\n        </div>\n    </div>\n\n    <!-- Items Table -->\n    <table>\n        <thead style=\"font-weight: bold;\">\n            <tr>\n                <th>\u0627\u0644\u0645\u0628\u0644\u063a</th>\n                <th>\u0627\u0644\u0633\u0639\u0631</th>\n                <th>\u0627\u0644\u0643\u0645\u064a\u0629</th>\n                <th>\u0627\u0644\u0635\u0646\u0641</th>\n            </tr>\n        </thead>\n\n        <tbody>\n            {% for item in doc.items %}\n                <tr>\n                    <td>{{ frappe.utils.fmt_money(item.amount or 0, currency=doc.currency) }}</td>\n                    <td>{{ frappe.utils.fmt_money(item.rate or 0, currency=doc.currency) }}</td>\n                    <td>{{ item.qty }}</td>\n                    <td>{{ item.item_name or item.description }}</td>\n                </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n\n    <!-- Totals -->\n    <table class=\"totals\">\n        <tr>\n            <td>\u0627\u0644\u0645\u062c\u0645\u0648\u0639 \u0627\u0644\u0641\u0631\u0639\u064a:</td>\n            <td>{{ frappe.utils.fmt_money(doc.total or 0, currency=doc.currency) }} {{ doc.currency }}</td>\n        </tr>\n\n        <tr>\n            <td>\u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629 (15%):</td>\n            <td>{{ frappe.utils.fmt_money(doc.total_taxes_and_charges or 0, currency=doc.currency) }} {{ doc.currency }}</td>\n        </tr>\n\n        <tr>\n            <td><strong>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a:</strong></td>\n            <td><strong>{{ frappe.utils.fmt_money(doc.grand_total or 0, currency=doc.currency) }} {{ doc.currency }}</strong></td>\n        </tr>\n    </table>\n\n    <!-- Notes -->\n    <div class=\"notes\">\n        <div>\n            <strong>\u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0627\u0644\u0623\u062d\u0643\u0627\u0645:</strong><br>\n            {{ doc.terms or '' }}\n        </div>\n    </div>\n\n</div>\n</body>\n</html>\n",
